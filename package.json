{
  "name": "@lumen/app",
  "version": "0.1.0",
  "private": true,
  "description": "A flexible B2B billing system for early-stage companies",
  "workspaces": [
    "api",
    "ui",
    "common"
  ],
  "scripts": {
    "predev": "./scripts/dev-setup.sh",
    "dev": "concurrently \"npm run dev:common\" \"npm run dev:api\" \"npm run dev:worker\" \"npm run dev:ui\" \"npm run dev:studio\"",
    "dev:debug": "concurrently \"npm run dev:common\" \"npm run dev:worker\" \"npm run dev:ui\"",
    "dev:common": "cd common && npm run dev",
    "dev:api": "cd api && npm run dev",
    "dev:api-debug": "cd api && bun --watch --inspect src/index.ts",
    "dev:api:stripe-mock": "cd api && npm run dev:stripe-mock",
    "dev:api:stripe-mock-with-worker": "concurrently \"npm run dev:api:stripe-mock\" \"npm run dev:worker\"",
    "dev:worker": "cd api && npm run dev:worker",
    "dev:ui": "cd ui && npm run dev",
    "dev:studio": "cd common && bunx drizzle-kit studio",
    "build": "cd common && bun run clean && bun run build && cd ../api && bun run build && cd ../ui && bun run build",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "typecheck": "cd api && npm run typecheck && cd ../ui && npm run typecheck",
    "docker:up": "./scripts/dev-setup.sh",
    "docker:down": "docker compose down -v",
    "docker:logs": "docker compose logs -f",
    "db:migrate": "cd common && npm run db:migrate",
    "db:generate": "cd common && npm run db:generate",
    "db:reset-schema": "./scripts/reset-schema.sh",
    "better-auth:generate-schema": "cd api && bunx @better-auth/cli@1.3.4 generate --output ../common/src/db/schema/auth.ts",
    "npm:delete-all": "rm -rf node_modules && rm -rf api/node_modules && rm -rf api/dist && rm -rf ui/node_modules && rm -rf ui/.next && rm -rf common/node_modules && rm -rf common/dist && rm -rf common/tsconfig.tsbuildinfo",
    "test:build": "bash scripts/test-local-build.sh",
    "stripe:webhook:listen": "bash scripts/stripe-webhook-listen-dev.sh",
    "generate:components": "bun run scripts/generate-shadcn-components.ts && bun run scripts/generate-standalone-pricing-table.ts"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/pg": "^8.11.13",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.30.6",
    "eslint": "^9.24.0",
    "lightningcss-linux-x64-gnu": "^1.29.3",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.787.0",
    "@marsidev/react-turnstile": "^1.4.0",
    "@types/luxon": "^3.6.2",
    "@types/pdfkit": "^0.13.9",
    "better-auth": "^1.2.7",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.41.0",
    "drizzle-zod": "^0.7.1",
    "luxon": "^3.6.1",
    "nanoid": "^5.1.5",
    "pg": "^8.14.1",
    "react-day-picker": "^9.6.7",
    "rrule": "^2.8.1"
  }
}