{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "dev:stripe-mock": "bun --preload tests/stripe-mock.ts --watch src/index.ts",
    "dev:worker": "bun --watch src/local-workers/event-persistence.ts",
    "build": "bun build src/index.ts src/local-workers/event-persistence.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "start:worker": "bun run dist/local-workers/event-persistence.js",
    "lint": "bun run eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "cd ../common && npm run db:generate",
    "db:migrate": "cd ../common && npm run db:migrate",
    "db:studio": "drizzle-kit studio",
    "test": "bun test",
    "test:stripe-mock": "bun test --preload tests/stripe-mock.ts",
    "test:watch": "bun test --watch",
    "data:generate": "bun run tests/scripts/generate.ts",
    "data:generate:minimal": "bun run tests/scripts/generate.ts template minimal",
    "data:generate:medium": "bun run tests/scripts/generate.ts template medium",
    "data:generate:large": "bun run tests/scripts/generate.ts template large-scale",
    "data:generate:list": "bun run tests/scripts/generate.ts list",
    "data:generate:custom": "bun run tests/scripts/generate.ts custom",
    "data:generate:full": "bun run tests/scripts/generate-full.ts",
    "dev:test-api": "bun run utils/manual-testing/test-api.ts",
    "dev:test-endpoint": "bun run utils/manual-testing/test-endpoint.ts",
    "dev:test-auth": "bun run utils/manual-testing/better-auth.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.777.0",
    "@aws-sdk/client-ssm": "^3.515.0",
    "@aws-sdk/s3-request-presigner": "^3.779.0",
    "@getlumen/better-auth": "^0.1.5",
    "@hono/zod-openapi": "^0.19.2",
    "@hono/zod-validator": "^0.4.3",
    "@lumen/common": "*",
    "@react-pdf/renderer": "^4.3.0",
    "@t3-oss/env-core": "^0.12.0",
    "@trigger.dev/sdk": "^3.3.17",
    "@types/bcrypt": "^5.0.2",
    "@types/dinero.js": "^1.9.4",
    "@types/node-sql-parser": "^1.1.0",
    "bcrypt": "^6.0.0",
    "better-auth": "^1.3.4",
    "bullmq": "^5.49.1",
    "commander": "^13.1.0",
    "common": "0.1.0",
    "dinero.js": "^1.9.1",
    "dodopayments": "^1.49.0",
    "hono": "^4.7.9",
    "hono-rate-limiter": "^0.4.2",
    "jose": "^6.0.10",
    "node-sql-parser": "^5.3.8",
    "pdfkit": "^0.16.0",
    "postgres": "^3.4.3",
    "react": "19.1.0",
    "redis": "^4.7.0",
    "resend": "^4.1.2",
    "standardwebhooks": "^1.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@trigger.dev/build": "^3.3.17",
    "@types/bun": "latest",
    "@types/minimist": "^1.2.5",
    "@types/node": "^20.11.24",
    "ansi-colors": "^4.1.3",
    "bun-types": "^1.2.5",
    "typescript": "^5.3.3"
  }
}
