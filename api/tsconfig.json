{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "composite": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["bun-types", "hono"],
    "lib": ["es6"],
    "outDir": "dist",
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "trigger.config.ts",
    "trigger/**/*.ts",
    "trigger/**/*.tsx"
  ],
  "exclude": ["node_modules", "dist", "workers", "tests"],
  "references": [{ "path": "../common" }],
  "allowImportingTsExtensions": true
}
