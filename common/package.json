{
  "name": "@lumen/common",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./validators": {
      "types": "./dist/validators/index.d.ts",
      "default": "./dist/validators/index.js"
    },
    "./pdf": {
      "types": "./dist/pdf/index.d.ts",
      "default": "./dist/pdf/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist tsconfig.tsbuildinfo 2>/dev/null || true",
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint \"src/**/*.ts*\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@questdb/nodejs-client": "^3.0.0",
    "@react-pdf/renderer": "^4.3.0",
    "dinero.js": "^1.9.1",
    "nanoid": "^5.1.5",
    "postgres": "^3.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^20.11.24",
    "eslint-plugin-react": "^7.37.4",
    "globals": "^16.0.0",
    "typescript": "^5.3.3"
  }
}
