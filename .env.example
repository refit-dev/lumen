# PostgreSQL Configuration
POSTGRES_USER=lumen
POSTGRES_PASSWORD=lumen_local
POSTGRES_DB=lumen
DATABASE_URL=postgres://lumen:lumen_local@localhost:5432/lumen

# MinIO Configuration
MINIO_ROOT_USER=lumen_minio
MINIO_ROOT_PASSWORD=lumen_minio_local
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=lumen-local

# pgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@lumen.local
PGADMIN_DEFAULT_PASSWORD=lumen_admin

# API Configuration
API_PORT=8000
CORS_ORIGIN=http://localhost:3000

# Environment
NODE_ENV=development

# API
API_HOST="localhost"
API_URL="http://localhost:3001"

# UI
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Authentication
JWT_SECRET="your-jwt-secret"

# Stripe
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"

# Trigger.dev
TRIGGER_API_KEY="tr_dev_your_trigger_api_key"
TRIGGER_API_URL="https://api.trigger.dev"

# Email (Resend)
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="billing@yourdomain.com"

# staging tests
API_BASE_URL=https://lumen-staging.pretzelai.app
LUMEN_API_KEY=sk_live_your_pretzel_api_key